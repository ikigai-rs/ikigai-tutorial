PREFIX qk: <https://ikigai-rs.dev/ns/quakes#> SELECT ?region (MAX(?mag) AS ?strongest) (COUNT(DISTINCT ?after) AS ?weekAfter) WHERE { ?quake qk:mag ?mag ; qk:place ?place ; qk:time ?time FILTER(?time < 1704672000000) BIND(REPLACE(REPLACE(?place, "^.*, ", ""), " Earthquake$", "") AS ?region) OPTIONAL { ?after qk:place ?afterPlace ; qk:time ?afterTime FILTER(?afterTime >= 1704672000000 && REPLACE(REPLACE(?afterPlace, "^.*, ", ""), " Earthquake$", "") = ?region) } } GROUP BY ?region ORDER BY DESC(?strongest) ?region