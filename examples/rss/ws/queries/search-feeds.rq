PREFIX rss: <http://purl.org/rss/1.0/>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX content: <http://purl.org/rss/1.0/modules/content/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
# The feeds a search matched, once each (for the OPML view). Fill with compose, q=TERMS.
SELECT DISTINCT ?feed ?feedTitle ?home (COUNT(?item) AS ?hits)
WHERE {
  ?item a rss:item ; dcterms:isPartOf ?feed .
  ?feed rss:title ?feedTitle ; rss:link ?home .
  OPTIONAL { ?item rss:title ?t } OPTIONAL { ?item rss:description ?s } OPTIONAL { ?item content:encoded ?f }
  FILTER(CONTAINS(LCASE(CONCAT(COALESCE(?t, ""), " ", COALESCE(?s, ""), " ", COALESCE(?f, ""))), LCASE("$r{{q}}")))
}
GROUP BY ?feed ?feedTitle ?home
ORDER BY DESC(?hits) ?feedTitle
